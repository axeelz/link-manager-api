{
  "name": "link-manager-api",
  "version": "2.0.0",
  "module": "src/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist",
    "start": "NODE_ENV=production bun dist/index.js",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "validate": "bun typecheck && bun fmt && bun lint"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.3",
    "@elysiajs/cors": "^1.4.1",
    "@libsql/client": "^0.17.2",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.28",
    "elysia-helmet": "^3.0.0",
    "elysia-ip": "^1.0.10",
    "isbot": "^5.1.36",
    "nanoid": "^5.1.7",
    "ua-parser-js": "^2.0.9"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.8",
    "@types/bun": "^1.3.11",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0"
  }
}
